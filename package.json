{
  "name": "museumx",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "dev": "concurrently -n api,web,app \"npm run dev --prefix server\" \"npm run dev --prefix client\" \"wait-on http://localhost:5173 http://localhost:4000/api/health && electron .\"",
    "build:client": "npm run build --prefix client",
    "start": "npm run build:client && concurrently -k -n api,app \"node server/src/index.js\" \"wait-on http://localhost:4000/api/health && MUSEUMX_PROD=1 electron .\"",
    "dist:dmg": "npm run build:client && electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.museumx.desktop",
    "productName": "MuseumX",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "client/dist/**/*",
      "server/src/**/*",
      "server/.env",
      "server/prisma/**/*",
      "server/node_modules/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "identity": null
    },
    "dmg": {
      "title": "MuseumX – Drag to Applications",
      "contents": [
        { "x": 150, "y": 200, "type": "file" },
        { "x": 400, "y": 200, "type": "link", "path": "/Applications" },
        { "x": 275, "y": 360, "type": "file", "path": "electron/HOW TO OPEN.txt" }
      ],
      "window": {
        "width": 540,
        "height": 440
      }
    }
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0",
    "wait-on": "^8.0.0"
  }
}
